# Copier ce fichier en .env et remplir. NE JAMAIS publier le fichier .env.

# --- Amazon SP-API (application privée sur votre compte vendeur) ---
SPAPI_CLIENT_ID=amzn1.application-oa2-client.xxxxxxxx
SPAPI_CLIENT_SECRET=xxxxxxxx
SPAPI_SELLER_ID=AXXXXXXXXXXXXX
# Un refresh token par région où vous vendez (EU = Europe + UK + Inde + Moyen-Orient)
SPAPI_REFRESH_TOKEN_EU=Atzr|xxxxxxxx
SPAPI_REFRESH_TOKEN_NA=
SPAPI_REFRESH_TOKEN_FE=

# --- Keepa API (abonnement API, distinct de l'abonnement Keepa classique) ---
KEEPA_API_KEY=xxxxxxxx
